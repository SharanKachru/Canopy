# ── Database (Supabase) ────────────────────────────────────────────────────
# Get from: Supabase dashboard → Settings → Database → Connection string (URI)
# Replace [YOUR-PASSWORD] with your actual password
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Google Earth Engine ────────────────────────────────────────────────────
# GCP project ID with Earth Engine API enabled
# Authenticate locally with: earthengine authenticate
GEE_PROJECT=your-gcp-project-id

# ── WhatsApp Cloud API ─────────────────────────────────────────────────────
# From Meta Business Suite → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxx
WHATSAPP_TEMPLATE_NAME=canopy_risk_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0

# ── Alert thresholds ───────────────────────────────────────────────────────
ALERT_THRESHOLD=70           # 0-100: risk score that triggers alerts
ALERT_COOLDOWN_HOURS=168     # hours between repeat alerts per zone (168 = 7 days)

# ── Scheduler (worker.py) ──────────────────────────────────────────────────
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0

# ── Zones file path (used by worker.py) ───────────────────────────────────
# Generated by: python -m scripts.seed_zones --geojson gadm41_KEN_2.json --country-code KE
CANOPY_ZONES_PATH=zones.geojson
